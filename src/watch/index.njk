---
layout: layouts/base.njk
title: "Watch"
description: "Short videos of Ferrite on the radio, on the firmware's own screens."
---
<div class="wrap clips">
  <header class="page-head">
    <h1>Watch</h1>
    <p class="lead">Ferrite on the firmware's own screens.</p>
  </header>
  {%- for v in videos %}
  <figure class="clip">
    <div class="clip-media">
      <video src="/video/{{ v.file }}.mp4" poster="/video/{{ v.file }}.jpg" width="1280" height="720" controls muted playsinline preload="none"></video>
      <button class="clip-play" type="button" aria-label="Play {{ v.title }}" hidden></button>
    </div>
    <figcaption><span class="tile-title">{{ v.title }} <span class="tile-len">· {{ v.length }}</span></span>{{ v.line }}</figcaption>
  </figure>
  {%- endfor %}
</div>
<script src="/assets/watch.js" defer></script>
