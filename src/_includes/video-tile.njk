<a class="tile" href="/video/{{ v.file }}.mp4" data-video="/video/{{ v.file }}.mp4">
  <span class="tile-media"><img src="/video/{{ v.file }}.jpg" alt="" width="1280" height="720" loading="lazy"><span class="play" aria-hidden="true"></span></span>
  <span class="tile-title">{{ v.title }} <span class="tile-len">· {{ v.length }}</span></span>
</a>
