---
layout: layouts/base.njk
title: "Blog"
description: "News from Ferrite, free firmware for the Radtel RT-950 Pro."
permalink: /blog/
---
<div class="wrap column">
  <header class="page-head">
    <h1>Blog</h1>
    <p class="lead">News from Ferrite: releases, what's new, and what we learned on the bench.
      <a href="{{ site.urls.blog }}/feed.xml">Subscribe by feed</a>.</p>
  </header>
  {% if collections.posts.length %}
  <ul class="post-list">
    {%- for post in collections.posts %}
    <li>
      <p class="meta"><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>{% if post.data.draft %}<span class="draft">Draft</span>{% endif %}</p>
      <h2><a href="{{ post.url | blogUrl }}">{{ post.data.title }}</a></h2>
      {% if post.data.summary %}<p>{{ post.data.summary }}</p>{% endif %}
    </li>
    {%- endfor %}
  </ul>
  {% else %}
  <p class="sub">No posts yet.</p>
  {% endif %}
</div>
